{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "opening": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "patient_facts": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "labs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 12000
      }
    },
    "media": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "test": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "asset_id",
          "test",
          "caption"
        ],
        "additionalProperties": false
      }
    },
    "reference_diagnosis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "source": {
      "default": "Synthetic",
      "type": "string",
      "enum": [
        "MedQA",
        "NEJM",
        "MediQ",
        "Synthetic"
      ]
    },
    "source_id": {
      "default": "",
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "id",
    "title",
    "opening",
    "patient_facts",
    "labs",
    "media",
    "reference_diagnosis",
    "source",
    "source_id"
  ],
  "additionalProperties": false
}
